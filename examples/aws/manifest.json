          ]
        }
      ]
    },
    "74378a9b-4c56-4192-8735-3d6c3184eb58": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Immutable ledger of all billable events: storage, requests, and data transfer."
