          ]
        }
      ]
    },
    "6a4e636c-0236-45c6-832b-b3f55fb7f2d0": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Persistent store for bucket and object ACL entries."
