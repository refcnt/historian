          ]
        }
      ]
    },
    "53b55280-76a8-469f-9a16-df4c51e6e0a9": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Tracks per-bucket storage usage, request counts, and data transfer for billing."
            }
          ]
        }
      ]
    },
    "7adc9908-e4f2-4f2b-b888-e77167df784d": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Stores object metadata: key, size, ETag, version ID, user-defined tags, and system metadata."
