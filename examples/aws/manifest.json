          ]
        }
      ]
    },
    "8d0913c5-ee52-4077-8f23-dbbe37828bdd": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Time-series store for per-bucket usage metrics consumed by the billing system."
