  "info": {
    "0850d36b-b7a6-41cb-accd-6d9e74ef47eb": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Handles all incoming S3 API requests. Authenticates, validates, and routes to the appropriate internal services."
            }
          ]
        }
      ]
    },
    "4774a51c-b6f7-4bd2-af99-0c566931269d": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Manages identity and access management. Validates credentials, checks bucket policies, and enforces ACLs."
            }
          ]
        }
      ]
    },
    "49d1664c-8b42-4ab4-b69a-1257745af06e": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Maintains the global namespace across all regions. Ensures consistent bucket/object naming and cross-region coordination."
            }
          ]
        }
      ]
    },
    "d08f4dd0-ae63-4e03-8695-dcdc790f143b": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Core data storage and lifecycle management. Handles object persistence, versioning, and tier transitions."
            }
          ]
        }
      ]
    },
    "e118d0dc-a65a-4f0b-8c66-73df93bc7027": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Event notification and usage metering. Emits S3 events to SNS/SQS/Lambda and tracks per-bucket usage."
            }
          ]
        }
      ]
    },
    "4a25ec6a-1605-4738-815f-e2eacdc45ce9": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Persistent data stores backing all S3 services. Stores object metadata, bucket configuration, and usage records."
            }
          ]
        }
      ]
    },
    "c66d939c-97eb-4668-b01f-2ae6aef8925e": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Public-facing S3 REST API endpoint. Terminates TLS, parses the request path, and dispatches to internal services."
            }
          ]
        }
      ]
    },
    "0b263ae7-df82-43ec-9f33-31e699cd6619": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Validates AWS Signature v4 credentials and evaluates IAM policies."
            }
          ]
        }
      ]
    },
    "69cae78c-4c9f-4883-a228-22ca2cbc3f5f": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Evaluates bucket policies, ACLs, and Object Lock conditions for every request."
            }
          ]
        }
      ]
    },
    "079bf2c2-a3f7-47f6-8b53-4442c047fb88": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Manages access control lists for buckets and objects."
            }
          ]
        }
      ]
    },
    "cc2772ed-c09c-4c9f-98bb-28c4e347c2b5": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Maintains the global flat object namespace. Resolves bucket ownership and performs cross-region lookups."
            }
          ]
        }
      ]
    },
    "46b64eda-7363-4b9a-829b-7f64c1423350": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Coordinates cross-region replication (CRR) and same-region replication (SRR) jobs."
            }
          ]
        }
      ]
    },
    "ecd8f978-1e34-416a-a965-a5985cc549d7": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Routes requests to the correct regional endpoint based on bucket location."
            }
          ]
        }
      ]
    },
    "53abcdc7-0470-41f2-8c24-452baacfd0db": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Resolves virtual-hosted-style bucket DNS names to regional endpoints."
            }
          ]
        }
      ]
    },
    "9b775e77-f5ed-44f0-af37-d74ec51709e6": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Tracks availability zone topology for placement decisions."
            }
          ]
        }
      ]
    },
    "164ad00a-127d-4a12-8b0c-935797f0443a": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Low-level object storage engine. Writes objects to distributed storage nodes with erasure coding."
            }
          ]
        }
      ]
    },
    "689af0fa-32e7-43d3-9172-eaba15559cae": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Applies S3 Lifecycle rules: transitions objects to Glacier, expires old versions, aborts multipart uploads."
            }
          ]
        }
      ]
    },
    "ea35ff21-3bee-4e08-b220-86b1866e50e6": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Manages object versioning. Maintains the version list and enforces Object Lock retention periods."
            }
          ]
        }
      ]
    },
    "b960e5e6-947f-4b67-bce2-42103fe7e9eb": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Handles multipart upload initiation, part tracking, and completion assembly."
            }
          ]
        }
      ]
    },
    "538afd34-edd8-4849-95d5-2d1b2c493f81": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Validates CRC32, SHA-256, and MD5 checksums on ingest and retrieval."
            }
          ]
        }
      ]
    },
    "9f2801ac-b5c0-47a8-9f4f-34595a629f17": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Manages SSE-S3, SSE-KMS, and SSE-C envelope encryption for stored objects."
            }
          ]
        }
      ]
    },
    "aaf9f2ed-0e6f-496e-a99d-68fd550554f8": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Moves objects between S3 storage classes (Standard, IA, Glacier) based on access patterns."
            }
          ]
        }
      ]
    },
    "924f5b7a-0961-4483-8352-c248ece5069b": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Handles Glacier restore requests, tracking restore status and expiry."
            }
          ]
        }
      ]
    },
    "ae573c5f-2f15-431f-a670-408249b652ab": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Encodes and decodes object data using Reed-Solomon erasure coding across AZs."
            }
          ]
        }
      ]
    },
    "300eea64-1d66-4252-87dc-6bcf2f47e4e8": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Maintains the S3 Inventory and S3 Select index for fast object enumeration and querying."
            }
          ]
        }
      ]
    },
    "04889ac6-8995-4b40-b689-a3277548c531": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Publishes S3 event notifications (s3:ObjectCreated, s3:ObjectRemoved, etc.) to SNS, SQS, or Lambda."
