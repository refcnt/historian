          ]
        }
      ]
    },
    "f7fab6a0-c202-45d5-8087-e93c05e9131e": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Stores bucket configuration: policies, CORS rules, logging settings, versioning state, lifecycle rules."
