          ]
        }
      ]
    },
    "7e8c3293-c9d8-4f6f-8e5d-e488feb49018": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Stores the ordered version list for every versioned object."
