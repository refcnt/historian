        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Stores lifecycle rule configurations per bucket."
            }
          ]
        }
      ]
    },
    "09982da2-d31f-408d-9c56-302a4c04e283": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Write-ahead log tracking replication job state across regions."
            }
          ]
        }
      ]
    },
    "48c521ca-1ec7-48e2-a4d0-abb98615df70": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
              "type": "text",
              "text": "Tracks in-progress multipart upload sessions and uploaded parts."
            }
          ]
        }
      ]
    },
    "84ca8585-1fa5-4a2c-989d-fcae4c361e69": {
      "tabs": [
        {
          "title": "Info",
          "content": [
            {
